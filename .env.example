# Copy to .env and fill in what you have. With nothing set, the office runs in offline sim mode.
# Keys stay on the server; the browser never sees them.

# --- Claude (Anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-4-5
# Reasoning effort for Claude models that support it: low | medium | high | xhigh | max | off
# (low keeps spoken replies snappy)
# CLAUDE_EFFORT=low

# --- Nous Research (hosted Hermes) ---
# NOUS_API_KEY=...
# NOUS_MODELS=Hermes-4-70B,Hermes-4-405B
# NOUS_BASE_URL=https://inference-api.nousresearch.com/v1

# --- Ollama (local). Models are discovered live; if Ollama isn't running they just don't appear. ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_URL=off

# --- OpenRouter ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODELS=openrouter/auto

# --- Any OpenAI-compatible server (vLLM, LM Studio, llama.cpp, Together, ...) ---
# OPENAI_COMPAT_URL=http://localhost:8000/v1
# OPENAI_COMPAT_MODELS=my-model
# OPENAI_COMPAT_KEY=
# OPENAI_COMPAT_LABEL=My server

# --- Server ---
# DEFAULT_MODEL=nous:Hermes-4-70B
# HOST=127.0.0.1
# PORT=8787
